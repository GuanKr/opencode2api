# Local credentials, deployment backups, and verification artifacts
.local/
*.availability.json

# Local-only artifacts (see AGENTS.md): rebuilt binary and its editor backups,
# the local usage history snapshot, the Clash watchdog's read-only config, and
# MCP browser scratch dirs. The usage-history patterns are wildcards on
# purpose: SaveUsageHistory also leaves <config>.usage.history.json.replace,
# .usage.history.json.corrupt.<unixnano>/.oversized.<unixnano> keeps, and
# .usage-history-*.tmp scratch files, and the config name is operator-chosen.
opencode2api.exe*
*.usage.history.json*
.usage-history-*.tmp
watchdog.json
.playwright-mcp/
# .workbuddy/ holds local session notes and ad-hoc node/proxy test dumps. Its
# memory files name live nodes and credentials-adjacent details, so it stays
# out of the repository entirely.
.workbuddy/

# merge-analysis/ is the scratch workspace for one upstream update: merge plans,
# conflict evidence, per-report drafts and the raw command transcripts under it.
# It is disposable — whatever survives from it is folded into AGENTS.md and into
# the code comments — so it must never be committed with the merge that produced
# the answers.
merge-analysis/
