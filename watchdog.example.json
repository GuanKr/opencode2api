{
  // 看门狗专用配置（只读，脚本从不写回）。放到 watchdog-clash.ps1 同目录即自动生效，
  // 也可用 -WatchdogConfig 指向别处。支持 // 与 /* */ 注释（与 config.json 同一套语义，
  // 字符串里的 https:// 不受影响）。
  // 优先级：显式命令行参数 > 本文件 > 脚本内置默认值。删除本文件 = 全部走内置默认值。

  // 代理组候选：看门狗只在这个组里逐个换节点。字符串或字符串数组都行；
  // 数组 = 候选列表，启动时与每轮 404 时都按顺序取第一个在当前配置里存在的
  // type=Selector 组。默认这两个正好覆盖「本地节点池」与「渔云订阅」两套配置，
  // 来回切不用改文件；换回机场订阅时把它的组名加进列表即可（如 "渔云CloudFisher"）。
  // 只认 type=Selector：url-test/fallback 组的 now 由测速决定，PUT 会拒绝。
  // 写错时的日志是「Selector [...] 不在当前 Clash 配置里（404）」并列出当前可用组名。
  "selector": ["🚀 节点选择", "渔云CloudFisher"],

  // profile uid：决定刷新哪份 profile、selected.now 写到哪个条目。
  // 留空 "" = 自动取 profiles.yaml 的 current:（当前激活的那份配置）。
  // 每次把本地 yaml 重新拖进 Clash Verge 都会生成新 uid，留空最省事；
  // 运行中重新导入时，下一次故障切换会重新解析 current: 并自动跟随（不必重启）。
  // 想钉死某一份（例如后台刷新另一份订阅）时才填具体 uid。
  "subscription_uid": "",

  // 单轮最多试多少个候选节点（1-300 的整数，省略即 120）。
  // 本地节点池 100 个 → 120 足够整池扫一遍；换更大的订阅就调大。
  // 注意最坏耗时随它线性增长（见 watchdog-clash.ps1 头部 .DESCRIPTION）。
  "max_candidates": 120,

  // 子串排除：节点名含任一子串即从候选池丢弃（大小写不敏感）。
  // 是整体替换内置默认值，不是追加——想加词就把内置那几项一起抄进来。
  // 留空数组 [] = 关闭子串排除。内置精确排除表（自动选择/DIRECT/节点超时请手动更新订阅 等）不受此项影响。
  // 注意：命中是子串匹配，容易误杀含该词的正常节点，例如加入「香港」会连带排除
  // 「香港高速Ⅱ 专线」这类想留的节点，请确认机场的命名习惯。
  "exclude_contains": [
    "剩余",
    "到期",
    "重置",
    "流量",
    "套餐",
    "官网",
    "中国"
  ],

  // 地区降权：节点名含关键词的候选排序时加罚分，延迟低但不稳定的地区靠这个压后。
  // 只降排序不排除：所有节点都被压后时，它仍会作为保底候选被选中。
  // contains 整体替换内置默认值（内置为 ["新加坡"]），[] = 关闭地区降权。
  // penalty_ms 是罚分毫秒数（内置 500，与 quota 失败降权 300000 叠加，钳位 999998）。
  "deprioritize": {
    "contains": [
      "新加坡"
    ],
    "penalty_ms": 500
  },

  // ---- WARP proxy 检查（Phase 1，2026-10-26）----
  // 背景：WARP 开启且 warp.proxy 指向本机 Clash 的 SOCKS5 入口时，看门狗改为检查
  // 该 SOCKS5 中继（TCP CONNECT + UDP DNS 往返），不再用 /v1/watchdog/probe 判断。
  // 注意：proxy 可用 ≠ WARP 可用；真实 egress 仍看 /healthz 的 warp_unavailable 与池日志。

  // 模式：auto = warp.enabled 且有 warp.proxy 时进入 proxy-check；off = 完全 legacy
  // （不读 config.json 的 warp 字段、不建 SOCKS5 连接）；force = warp.enabled=false
  // 但 warp.proxy 有值时也检查。默认 auto，复制本文件不会改变现有行为。
  "proxy_check_mode": "auto",

  // WARP 模式检查间隔（5-300 秒）。健康路径按它轮询；失败路径还要多等 recheck。
  "proxy_check_interval_seconds": 15,

  // 首次失败后的复检等待（0-30 秒）；0 = 跳过复检，直接确认失败（仍受切换条件约束）。
  // 失败轮的实际确认周期 ≈ interval + recheck（默认约 20s+）。
  "proxy_check_recheck_seconds": 5,

  // 单次完整检查（TCP + UDP）的总预算（3-30 秒），不是每步预算。
  // TCP 每目标最多 2s（api.cloudflareclient.com:443 → cloudflare.com:443 → 1.1.1.1:443），
  // UDP 每目标最多 3s（默认 1.1.1.1:53，失败回退 8.8.8.8:53）；剩余 <1s 不再启动新目标。
  "proxy_check_timeout_seconds": 8,

  // UDP DNS 检查目标（host:port 或 [IPv6]:port）。只证明 SOCKS5 UDP relay 能往返，
  // 不证明到 WARP 外层端点 engage.cloudflareclient.com:2408 的 UDP 可用。
  "proxy_check_udp_target": "1.1.1.1:53",

  // 是否要求 UDP 也通过（默认 true）。某些节点允许 WARP UDP 但封 DNS 53，可设 false
  // 降级为 TCP-only（此时 WARP 仍可能不可用）；也可换 proxy_check_udp_target。
  "proxy_check_require_udp": true,

  // 是否允许切 Clash 节点：auto（默认）只认「warp.proxy 是 loopback 且端口等于
  // clash-verge.yaml 的 mixed-port/socks-port」这一正向证据；HTTP port 不算。
  // 读不到 yaml / 端口不匹配 / 远端 SOCKS5 → 只监控并打日志，不切换。on 强制，off 只监控。
  "proxy_check_failover": "auto",

  // 切到候选后、验证前的等待（0-30 秒，等 Clash 收敛）。
  "proxy_switch_gap_seconds": 2,

  // 单轮 failover 总时间预算（30-600 秒）。超时停止候选循环并回滚，避免大候选池
  // 每个候选都等 gap+检查把一轮拖到十几分钟；回滚后进入 round cooldown。
  "proxy_failover_budget_seconds": 120,

  // transport 连续确认轮数（1-10，默认 2）：网关报 anonymous.verdict=transport 时，
  // 需连续 N 轮仍为 transport 才刷新/切换，单轮网络抖动只观察不动作。
  // 等价于命令行 -TransportConfirmRounds；两者同时存在时「命令行显式传参」优先。
  // 值必须是整数（不要加引号、不要写小数），写错会让看门狗启动失败并指出是哪一项。
  // 文件里的值即使被显式命令行参数覆盖也照样校验（只是不生效）——所以写错了照样起不来。
  // 1 = 单轮即动作（最激进，也最容易被抖动误触发）；越大越能容忍抖动，但坏节点切换更慢。
  // quota / all_down / 节点失效走立即路径，不受此项影响。计数只存在进程内存，重启清零。
  // -Once 单轮模式不使用这个值（单轮攒不出连续计数，固定按 1 轮执行）。
  // 配置只在看门狗启动时读一次：改完本文件必须重启看门狗才生效。
  "transport_confirm_rounds": 2,

  // ---- WARP 出口失败触发（2026-10-26）----
  // 背景：WARP 模式下 SOCKS5 中继可能健康，但网关的 WARP 出口连续失败（上游 429/403/
  // 传输失败/首事件超时等），此时换 Clash 节点才是解法。脚本在中继检查通过后只读
  // GET /healthz（5s 超时；失败后 60s 退避），读 warp.failure_streak（主信号）与
  // warp.status/active；主信号缺失或为 0、但出口池连续 unavailable/active=0 达
  // threshold 轮（本地计数）同样触发，避免“建不出任何出口”时永远不动作。
  // 整个块可省略；省略即 enabled=false（保持旧行为）。未知键/类型不对/小数/越界
  // 一律启动失败，与其它配置项同一口径。
  "warp_exit_failure": {
    // 总开关。省略整块时默认 false；开启后才会读 /healthz 并可能刷新/切换。
    "enabled": true,

    // failure_streak（或出口池不可用本地轮数）达到多少才动作（1-100，默认 9）。
    // 动作后以当时连击为新基线，需再涨同样多才会重复触发。
    "threshold": 9,

    // 动作后的冷却分钟数（0-120，默认 15）：冷却期内即使再次达标也不动作。
    // 只作用于本触发器，不碰中继失败/legacy 的 round cooldown。
    "cooldown_minutes": 15,

    // 连击连续归零多少轮才清除动作基线（1-10，默认 2）；动作后的前 N 轮也不累计
    // “出口池不可用”本地计数，给 WARP 重新注册留时间。
    "reset_rounds": 2,

    // 触发后的动作：
    //   refresh_only         只刷新订阅（受 RefreshCooldownMinutes 节流）；
    //   refresh_then_switch  先刷新（节流/失败只记日志、继续），再按 WARP 候选排序切换；
    //   switch_only          不刷新，直接切换。
    // 成功切换后 POST /v1/watchdog/warp/reset（server_keys 鉴权；404/405 视为旧网关忽略），
    // 让网关退役旧出口。等价命令行参数：-WarpExitFailureEnabled / -WarpExitFailureThreshold /
    // -WarpExitFailureCooldownMinutes / -WarpExitFailureResetRounds / -WarpExitFailureAction。
    "action": "refresh_then_switch"
  }
}
